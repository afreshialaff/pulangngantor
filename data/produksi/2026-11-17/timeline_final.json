  {
   "id": "S05",
   "vo_start": 67.139,
   "vo_end": 80.701,
   "sents": [
    {
     "i": 14,
     "para": 4,
     "start": 67.139,
     "end": 68.723,
     "text": "Lalu kapan ditulis?",
     "exp": 1.09
    },
    {
     "i": 15,
     "para": 4,
     "start": 69.343,
     "end": 73.864,
     "text": "Tahun dua ribu sembilan, Universitas Arizona menguji umur kulitnya dengan radiokarbon.",
     "exp": 4.83
    },
    {
     "i": 16,
     "para": 4,
     "start": 74.235,
     "end": 78.201,
     "text": "Hasilnya antara tahun seribu empat ratus empat dan seribu empat ratus tiga puluh delapan.",
     "exp": 4.98
    },
    {
     "i": 17,
     "para": 4,
     "start": 78.618,
     "end": 80.701,
     "text": "Jadi ini memang naskah abad kelima belas.",
     "exp": 2.34
    }
   ],
   "bagian": "Latar belakang",
   "label": "1404-1438",
   "vo_dur": 13.562,
