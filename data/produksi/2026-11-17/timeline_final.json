   "seg_len": 17.802,
   "stretch": 1.1836,
   "t0": 220.758,
   "vo_at": 221.208,
   "seg_actual": 17.75
  },
  {
   "id": "S16",
   "vo_start": 232.966,
   "vo_end": 248.205,
   "sents": [
    {
     "i": 46,
     "para": 15,
     "start": 232.966,
     "end": 234.593,
     "text": "Tapi ada sisi yang janggal juga.",
     "exp": 1.71
    },
    {
     "i": 47,
     "para": 15,
     "start": 235.154,
     "end": 242.565,
     "text": "Keteraturan huruf demi huruf, yang disebut entropi kondisional, hanya sekitar dua, sedangkan bahasa alami umumnya tiga sampai empat.",
     "exp": 7.16
    },
    {
     "i": 48,
     "para": 15,
     "start": 242.993,
     "end": 248.205,
     "text": "Hurufnya terlalu mudah ditebak, dan itu membuat sebagian peneliti ragu ini bahasa biasa.",
     "exp": 4.98
    }
   ],
   "bagian": "Bukti & analisis",
   "label": "TERLALU TERATUR",
   "vo_dur": 15.239,
   "trans": [
