   "seg_actual": 15.208333
  },
  {
   "id": "S13",
   "vo_start": 185.447,
   "vo_end": 200.229,
   "sents": [
    {
     "i": 36,
     "para": 12,
     "start": 185.447,
     "end": 187.086,
     "text": "Tentu banyak yang mencoba membacanya.",
     "exp": 1.87
    },
    {
     "i": 37,
     "para": 12,
     "start": 187.515,
     "end": 193.183,
     "text": "Di abad kedua puluh, para pemecah sandi terbaik, termasuk tim William Friedman, ikut mengerjakannya.",
     "exp": 4.83
    },
    {
     "i": 38,
     "para": 12,
     "start": 193.893,
     "end": 198.918,
     "text": "Pendekatan utamanya menganggap ini sandi huruf biasa, yang diacak dengan aturan tertentu.",
     "exp": 4.67
    },
    {
     "i": 39,
     "para": 12,
     "start": 199.407,
     "end": 200.229,
     "text": "Semuanya gagal.",
     "exp": 0.78
    }
   ],
   "bagian": "Bukti & analisis",
