    },
    {
     "i": 9,
     "para": 2,
     "start": 38.629,
     "end": 43.998,
     "text": "Bagian tumbuhan paling tebal, sekitar seratus dua puluh enam halaman.",
     "exp": 3.58
    },
    {
     "i": 10,
     "para": 2,
     "start": 44.392,
     "end": 50.538,
     "text": "Lalu ada diagram bintang, perempuan telanjang di antara kolam dan pipa, gambar botol obat, dan bagian yang mirip daftar resep.",
     "exp": 6.07
    }
   ],
