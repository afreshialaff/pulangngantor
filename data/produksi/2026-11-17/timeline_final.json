   "vo_end": 280.141,
   "sents": [
    {
     "i": 52,
     "para": 17,
     "start": 264.634,
     "end": 270.031,
     "text": "Teori kedua: ini bahasa sungguhan, atau mungkin bahasa buatan dengan aksara khusus.",
     "exp": 4.36
    },
    {
     "i": 53,
     "para": 17,
     "start": 270.327,
     "end": 274.257,
     "text": "Usulannya banyak, dari Nahuatl, Ibrani, sampai Turki kuno.",
     "exp": 2.96
    },
    {
     "i": 54,
