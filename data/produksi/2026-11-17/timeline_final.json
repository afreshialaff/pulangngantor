   "seg_actual": 15.958333
  },
  {
   "id": "S15",
   "vo_start": 216.027,
   "vo_end": 232.229,
   "sents": [
    {
     "i": 43,
     "para": 14,
     "start": 216.027,
     "end": 226.023,
     "text": "Tahun dua ribu tiga belas, Marcelo Montemurro dan Damián Zanette menemukan kata-kata kunci naskah ini mengelompok mengikuti topik, dan bagian bertanaman berbagi kosakata.",
     "exp": 9.34
    },
    {
     "i": 44,
     "para": 14,
     "start": 226.665,
     "end": 229.155,
     "text": "Mereka menyimpulkan ada struktur layaknya bahasa.",
     "exp": 2.65
    },
    {
     "i": 45,
     "para": 14,
     "start": 229.812,
     "end": 232.229,
     "text": "Tapi itu bukan pembacaan, kata mereka sendiri.",
     "exp": 2.65
    }
   ],
   "bagian": "Bukti & analisis",
   "label": "ADA STRUKTUR",
   "vo_dur": 16.202,
   "trans": [
    "dissolve",
    0.6
   ],
