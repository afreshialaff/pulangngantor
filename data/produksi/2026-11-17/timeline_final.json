  },
  {
   "id": "S06",
   "vo_start": 81.404,
   "vo_end": 96.987,
   "sents": [
    {
     "i": 18,
     "para": 5,
     "start": 81.404,
     "end": 85.395,
     "text": "Satu catatan penting: yang diuji kulitnya, bukan tintanya.",
     "exp": 2.8
    },
    {
     "i": 19,
     "para": 5,
     "start": 86.041,
     "end": 91.249,
     "text": "Tapi pemindaian multispektral tidak menemukan tulisan lama di bawahnya, jadi ini bukan kulit bekas.",
     "exp": 5.29
    },
    {
     "i": 20,
     "para": 5,
     "start": 91.835,
     "end": 96.987,
     "text": "Dan hasil ini mematahkan dugaan lama bahwa penulisnya Roger Bacon, ilmuwan abad ketiga belas.",
     "exp": 5.14
    }
   ],
   "bagian": "Latar belakang",
   "label": "BUKAN ROGER BACON",
