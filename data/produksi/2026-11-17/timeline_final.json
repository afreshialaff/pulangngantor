   "vo_end": 264.205,
   "sents": [
    {
     "i": 49,
     "para": 16,
     "start": 248.473,
     "end": 250.084,
     "text": "Teori pertama: tipuan.",
     "exp": 1.09
    },
    {
     "i": 50,
     "para": 16,
     "start": 250.634,
     "end": 257.875,
     "text": "Tahun dua ribu tiga, Gordon Rugg menunjukkan teks yang mirip bisa dibuat dengan tabel suku kata dan kartu berlubang Cardan grille.",
     "exp": 6.23
    },
    {
     "i": 51,
     "para": 16,
     "start": 258.221,
     "end": 264.205,
     "text": "Tapi mirip belum tentu sama, dan Montemurro menilai bukti strukturnya membatasi kemungkinan tipuan.",
     "exp": 5.14
    }
   ],
   "bagian": "Bukti & analisis",
   "label": "TEORI 1: TIPUAN",
   "vo_dur": 15.732,
   "trans": [
