   "seg_actual": 15.583333
  },
  {
   "id": "S08",
   "vo_start": 112.136,
   "vo_end": 125.88,
   "sents": [
    {
     "i": 25,
     "para": 7,
     "start": 112.136,
     "end": 119.112,
     "text": "Menurut surat tahun seribu enam ratus enam puluh lima, Kaisar Rudolf II pernah membelinya seharga enam ratus dukat emas.",
     "exp": 6.54
    },
    {
     "i": 26,
     "para": 7,
     "start": 119.537,
     "end": 120.526,
     "text": "Tapi itu kabar turunan.",
     "exp": 1.4
    },
    {
     "i": 27,
     "para": 7,
     "start": 120.996,
     "end": 125.88,
     "text": "Istana memang mencatat pembelian buku tahun seribu lima ratus sembilan puluh sembilan, belum terbukti itu naskah ini.",
     "exp": 6.38
    }
   ],
   "bagian": "Kronologi",
   "label": "600 DUKAT?",
   "vo_dur": 13.744,
   "trans": [
    "smoothleft",
    0.5
   ],
   "slot": 14.744,
   "seg_len": 15.244,
   "stretch": 1.0136,
   "t0": 114.592,
   "vo_at": 115.042,
   "seg_actual": 15.208333
  },
  {
   "id": "S09",
   "vo_start": 126.287,
   "vo_end": 140.226,
   "sents": [
    {
     "i": 28,
     "para": 8,
     "start": 126.287,
     "end": 132.37,
     "text": "Pemilik pertama yang pasti terdokumentasi adalah Georg Baresch, seorang alkemis di Praha.",
     "exp": 4.51
    },
    {
     "i": 29,
     "para": 8,
     "start": 132.983,
     "end": 140.226,
     "text": "Tahun seribu enam ratus tiga puluh sembilan ia menulis surat kepada Athanasius Kircher di Roma dan mengirim contoh tulisan dari buku itu.",
     "exp": 7.63
    }
   ],
   "bagian": "Kronologi",
   "label": "SURAT 1639",
   "vo_dur": 13.939,
   "trans": [
    "smoothleft",
    0.5
   ],
   "slot": 14.939,
   "seg_len": 15.439,
   "stretch": 1.0265,
   "t0": 129.3,
   "vo_at": 129.75,
   "seg_actual": 15.416667
  },
  {
   "id": "S10",
   "vo_start": 140.878,
   "vo_end": 155.271,
   "sents": [
    {
     "i": 30,
     "para": 9,
     "start": 140.878,
     "end": 149.109,
     "text": "Setelah Baresch wafat, bukunya diwariskan ke Johannes Marcus Marci, yang mengirimnya ke Kircher lewat surat tahun seribu enam ratus enam puluh lima.",
     "exp": 7.63
    },
    {
     "i": 31,
     "para": 9,
     "start": 149.815,
     "end": 155.271,
     "text": "Dari surat itulah kisah Rudolf dan Roger Bacon bermula, dan Marci sendiri tidak menjaminnya.",
     "exp": 4.83
    }
   ],
   "bagian": "Kronologi",
   "label": "SURAT 1665",
   "vo_dur": 14.393,
   "trans": [
    "smoothleft",
    0.5
   ],
   "slot": 15.393,
   "seg_len": 15.893,
   "stretch": 1.0567,
   "t0": 144.217,
   "vo_at": 144.667,
   "seg_actual": 15.833333
  },
  {
   "id": "S11",
   "vo_start": 155.946,
   "vo_end": 170.69,
   "sents": [
    {
     "i": 32,
     "para": 10,
     "start": 155.946,
     "end": 163.496,
     "text": "Naskah itu tersimpan di perpustakaan Jesuit di Roma selama berabad-abad, sampai harta mereka disita tahun seribu delapan ratus tujuh puluh tiga.",
     "exp": 7.94
    },
    {
     "i": 33,
     "para": 10,
     "start": 164.054,
     "end": 170.69,
     "text": "Tahun seribu sembilan ratus dua belas, pedagang buku langka Wilfrid Voynich membelinya, dan namanya melekat sampai sekarang.",
     "exp": 6.23
    }
   ],
   "bagian": "Kronologi",
   "label": "1912: VOYNICH",
   "vo_dur": 14.744,
   "trans": [
    "smoothleft",
    0.5
   ],
   "slot": 15.744,
   "seg_len": 16.244,
   "stretch": 1.0801,
   "t0": 159.55,
   "vo_at": 160.0,
   "seg_actual": 16.208333
  },
  {
   "id": "S12",
   "vo_start": 171.311,
   "vo_end": 184.775,
   "sents": [
    {
     "i": 34,
     "para": 11,
     "start": 171.311,
     "end": 179.974,
     "text": "Setelah Voynich meninggal, bukunya akhirnya dibeli pedagang buku Hans Kraus tahun seribu sembilan ratus enam puluh satu seharga dua puluh empat ribu lima ratus dolar.",
     "exp": 8.72
    },
    {
     "i": 35,
     "para": 11,
     "start": 180.667,
     "end": 184.775,
     "text": "Delapan tahun kemudian, ia menyumbangkannya ke Perpustakaan Beinecke di Yale.",
     "exp": 3.89
    }
   ],
   "bagian": "Kronologi",
   "label": "1969: YALE",
   "vo_dur": 13.464,
   "trans": [
    "fadeblack",
    0.8
   ],
   "slot": 14.464,
   "seg_len": 15.264,
   "stretch": 1.0149,
