     "i": 11,
     "para": 3,
     "start": 51.098,
     "end": 54.279,
     "text": "Tulisannya yang paling bikin pusing.",
     "exp": 1.71
    },
    {
     "i": 12,
     "para": 3,
     "start": 54.87,
     "end": 62.13,
     "text": "Sekitar dua puluh sampai dua puluh lima karakter menyusun sebagian besar teks, mengalir dari kiri ke kanan, hampir tanpa tanda baca.",
     "exp": 6.69
    },
    {
     "i": 13,
     "para": 3,
     "start": 62.699,
     "end": 66.684,
     "text": "Totalnya sekitar tiga puluh delapan ribu kata, tak satu pun kita tahu artinya.",
     "exp": 4.36
    }
   ],
