  {
   "id": "S07",
   "vo_start": 97.542,
   "vo_end": 111.654,
   "sents": [
    {
     "i": 21,
     "para": 6,
     "start": 97.542,
     "end": 101.833,
     "text": "Jejak pertamanya baru muncul hampir dua abad kemudian, di kota Praha.",
     "exp": 3.58
    },
    {
     "i": 22,
     "para": 6,
     "start": 102.313,
     "end": 108.151,
     "text": "Ada tanda tangan samar di halaman pertama: Jacobus Horčický de Tepenec, yang diangkat jadi bangsawan kecil.",
     "exp": 5.45
    },
    {
     "i": 23,
     "para": 6,
     "start": 108.797,
     "end": 110.044,
     "text": "Siapa pemilik sebelum dia?",
     "exp": 1.4
    },
    {
     "i": 24,
     "para": 6,
     "start": 110.521,
     "end": 111.654,
     "text": "Tidak ada yang tahu pasti.",
     "exp": 1.4
    }
   ],
   "bagian": "Kronologi",
   "label": "PRAHA, ABAD 17",
   "vo_dur": 14.112,
   "trans": [
