     "exp": 4.67
    },
    {
     "i": 7,
     "para": 1,
     "start": 28.822,
     "end": 33.706,
     "text": "Sekitar dua ratus empat puluh halaman bertahan, padahal aslinya setidaknya dua ratus tujuh puluh dua.",
