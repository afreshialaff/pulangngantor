  {
   "id": "S14",
   "vo_start": 200.906,
   "vo_end": 215.3,
   "sents": [
    {
     "i": 40,
     "para": 13,
     "start": 200.906,
     "end": 203.117,
     "text": "Anehnya, teksnya tidak terlihat ngawur.",
     "exp": 1.87
    },
    {
     "i": 41,
     "para": 13,
     "start": 203.662,
     "end": 212.665,
     "text": "Pola kata-katanya mirip bahasa asli lewat hukum Zipf: kata paling sering muncul sekitar dua kali lebih sering dari kata kedua, dan tiga kali dari kata ketiga.",
     "exp": 8.56
    },
    {
     "i": 42,
     "para": 13,
     "start": 213.259,
     "end": 215.3,
     "text": "Itu pola yang sulit ditiru asal-asalan.",
     "exp": 2.34
    }
   ],
   "bagian": "Bukti & analisis",
   "label": "POLA BAHASA?",
   "vo_dur": 14.394,
   "trans": [
    "zoomin",
